# =====================================================================
# Configurações do Sistema de Auditoria de Erros de Apontamento
# Copie este arquivo para .env na raiz do projeto e ajuste as credenciais
# =====================================================================

# Porta de execução da API FastAPI
PORT=8484

# Endereço da Intranet
INTRANET_HOST=http://192.168.0.6
INTRANET_BASE_URL=http://192.168.0.6/pcp

# =====================================================================
# Configuração do Servidor de Envio de E-mails (SMTP)
# =====================================================================

# 1) Exemplo: Servidor Corporativo Microsoft 365 / Outlook
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=pcp@liderinteriores.com.br
# SMTP_PASSWORD=sua_senha_ou_senha_de_app
# SMTP_FROM=pcp@liderinteriores.com.br
# SMTP_USE_TLS=true
# SMTP_SIMULATION_MODE=false

# 2) Exemplo: Relay Interno da Intranet / Rede Local (sem senha)
# SMTP_HOST=192.168.0.X
# SMTP_PORT=25
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=pcp@liderinteriores.com.br
# SMTP_USE_TLS=false
# SMTP_SIMULATION_MODE=false

# 3) Exemplo: Gmail (usar Senha de Aplicativo de 16 caracteres gerada na Conta Google)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seu_email@gmail.com
# SMTP_PASSWORD=abcd efgh ijkl mnop
# SMTP_FROM=seu_email@gmail.com
# SMTP_USE_TLS=true
# SMTP_SIMULATION_MODE=false

# ---------------------------------------------------------------------
# Configurações ativas de SMTP:
# Se SMTP_HOST for deixado em branco ou SMTP_SIMULATION_MODE=true,
# o sistema simula o envio e registra em backend/storage/sent_emails.json
# sem disparar e-mails reais.
# ---------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=pcp@liderinteriores.com.br
SMTP_USE_TLS=true
SMTP_SIMULATION_MODE=false
